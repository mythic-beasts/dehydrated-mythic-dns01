. "$(dirname "$0")"/../common/mythic-dns01

if [ "$CHALLENGETYPE" != "dns-01" ]; then
    exit 0
fi

echo -ne "$ARGS" | while read domain filename token; do
    echo " ++ cleaning DNS for $domain"
    call_api DELETE _acme-challenge.$domain $token
done
